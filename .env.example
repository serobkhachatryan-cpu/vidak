# Explicit auth provider selection.
# Development may omit this and default to `dev`.
# Production MUST set AUTH_PROVIDER explicitly (`dev` or `w3ds`); there is no
# silent fallback to development authentication.
AUTH_PROVIDER=dev

# Browser-safe provider identifier. The web build derives this from AUTH_PROVIDER
# when omitted, but set it explicitly for nonstandard build environments.
NEXT_PUBLIC_AUTH_PROVIDER=dev

# Canonical browser origin for cookie-authenticated mutations (Origin/Referer).
# Required in production when AUTH_PROVIDER=w3ds.
# APP_ORIGIN=https://vidak.example

# Optional extra trusted browser origins (comma-separated), in addition to APP_ORIGIN.
# TRUSTED_ORIGINS=https://preview.vidak.example

# Required when AUTH_PROVIDER=w3ds and the W3DS auth route handlers are enabled.
W3DS_AUTH_PLATFORM_NAME=vidak
W3DS_REGISTRY_BASE_URL=https://registry.example.com
# Generate a unique secret with at least 32 characters; never commit its real value.
# Server-only — never use NEXT_PUBLIC_* for this or other secrets.
W3DS_AUTH_JWT_SECRET=replace-with-a-long-random-secret

# The private Meshenger video library uses the documented Registry
# /platforms/certification flow with W3DS_AUTH_PLATFORM_NAME. It does not need
# a user key, an eVault URL, or a browser-visible credential.

# Optional: import a creator's own YouTube or Vimeo channel. The feature stays
# unavailable until EVERY variable below is set server-side. Never use NEXT_PUBLIC_
# for credentials, OAuth state, or encryption material.
# CHANNEL_IMPORT_STATE_SECRET=replace-with-a-32-character-or-longer-random-secret
# CHANNEL_IMPORT_TOKEN_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-random-key
# YOUTUBE_OAUTH_CLIENT_ID=
# YOUTUBE_OAUTH_CLIENT_SECRET=
# VIMEO_OAUTH_CLIENT_ID=
# VIMEO_OAUTH_CLIENT_SECRET=
# Register these exact production callbacks with the providers:
# https://vidak.postplatforms.com/api/channel-imports/callback/youtube
# https://vidak.postplatforms.com/api/channel-imports/callback/vimeo

# Optional: provision Vidak's own eVault once at server startup. This is
# separate from user eVaults and their eID signing keys. Keep disabled until
# the Registry/Provisioner credentials and public discovery profile are ready.
# W3DS_PLATFORM_EVAULT_ENABLED=false
# W3DS_PROVISIONER_BASE_URL=https://provisioner.example.com
# W3DS_PLATFORM_EVAULT_VERIFICATION_ID=server-only-provisioning-code
# W3DS_PLATFORM_EVAULT_URL=https://vidak.example
# W3DS_PLATFORM_EVAULT_DISPLAY_NAME=Vidak
# W3DS_PLATFORM_EVAULT_DESCRIPTION=Decentralized video publishing
# W3DS_PLATFORM_EVAULT_VERSION=1.0.0
# W3DS_PLATFORM_EVAULT_LOGO_URL=https://vidak.example/logo.png
# W3DS_PLATFORM_EVAULT_CATEGORY=Social

# Optional: Ontology catalogue mode for platform consumption.
# Default (and recommended for Vidak platform-local use): vidak_private
# metastate_official stays disabled unless set explicitly.
# W3DS_ONTOLOGY_MODE=vidak_private
#
# Private catalogue routes (always read-only, Vidak-owned — not MetaState W3IDs):
#   GET /api/w3ds/ontology/schemas
#   GET /api/w3ds/ontology/schemas/{schemaId}
# Stable private IDs: vidak:private:ontology:v1:{video|channel|playlist|comment}
# See docs/architecture/w3ds-private-ontology.md
#
# Optional: Vidak-private adapter sync (server-only, durable projections/mappings).
# Remains disabled unless BOTH private mode and explicit adapter enablement are set.
# Does NOT call MetaState Ontology, MetaState eVault, Awareness, ACL, or remote
# w3ds://file upload. Private IDs/envelopes are never MetaState-issued or public W3DS.
# W3DS_ONTOLOGY_ADAPTER_ENABLED=false
# W3DS_ONTOLOGY_BASE_URL=https://vidak.example/api/w3ds/ontology
# W3DS_ONTOLOGY_SCHEMA_ID_PROFILE=
# W3DS_ONTOLOGY_SCHEMA_ID_CHANNEL=
# W3DS_ONTOLOGY_SCHEMA_ID_VIDEO=
# W3DS_ONTOLOGY_SCHEMA_ID_PLAYLIST=
# W3DS_ONTOLOGY_SCHEMA_ID_COMMENT=
# W3DS_ADAPTER_MAPPING_VERSION=1
#
# Explicit MetaState official catalogue (disabled by default; unchanged / not used
# by Vidak-private adapter sync):
# W3DS_ONTOLOGY_MODE=metastate_official
# W3DS_ONTOLOGY_BASE_URL=https://ontology.w3ds.metastate.foundation

# Required for W3DS auth persistence (offers, users, sessions). Unused by AUTH_PROVIDER=dev.
# Local Docker: docker compose --profile postgres up -d postgres
DATABASE_URL=postgresql://vidak:vidak@127.0.0.1:5432/vidak

# Optional root directory for LocalDiskMediaStorage (development). Defaults to .data/media.
# MEDIA_STORAGE_ROOT=/absolute/path/to/media
# Integration/workflow Vitest suites ignore this and use an isolated OS temp directory.

# Optional media upload limits for protected transfer routes (defaults shown).
# MEDIA_MAX_UPLOAD_BYTES=104857600
# MEDIA_ALLOWED_CONTENT_TYPES=video/mp4,video/webm,video/quicktime

# Optional temporary compatibility gate for old eID Wallet versions.
# W3DS_AUTH_MIN_WALLET_VERSION=0.4.0

# Optional resource-authorization provider override (server-only).
# Defaults from AUTH_PROVIDER: dev → local, w3ds → w3ds.
# Local policy evaluation is always available. Durable remote grant sync exists
# but stays fail-closed until an official W3DS authorization/ACL SDK client is
# installed (@w3ds/sdk is empty today — do not invent eVault ACL HTTP calls).
# W3DS_AUTHZ_PROVIDER=local
