{
  "name": "@w3ds/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && mkdir -p .next/standalone/apps/web/.next && cp -R .next/static .next/standalone/apps/web/.next/",
    "start": "next start",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "channel-import:sync": "tsx src/server/channel-import-worker.ts",
    "clean": "rm -rf .next"
  },
  "dependencies": {
    "@tanstack/react-query": "latest",
    "@w3ds/api-client": "workspace:*",
    "@w3ds/auth": "workspace:*",
    "@w3ds/channel-page": "workspace:*",
    "@w3ds/config": "workspace:*",
    "@w3ds/design-tokens": "workspace:*",
    "@w3ds/hooks": "workspace:*",
    "@w3ds/settings-page": "workspace:*",
    "@w3ds/types": "workspace:*",
    "@w3ds/ui": "workspace:*",
    "@w3ds/upload-page": "workspace:*",
    "@w3ds/user-profile-page": "workspace:*",
    "@w3ds/watch-page": "workspace:*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "drizzle-orm": "^0.45.2",
    "next": "latest",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "latest",
    "react-dom": "latest",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@tailwindcss/postcss": "latest",
    "@types/pg": "^8.20.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "latest",
    "tsx": "^4.23.5"
  }
}
